# Dockerfile.bee-client — Build the Bee Client Tauri app (app/).
#
# The Bee Client is a Tauri 2.x desktop app with a React + Vite + Tailwind
# frontend and a Rust backend (see app/src-tauri/). It is typically built
# locally on the host with `cargo tauri build` (or `npm run tauri build`)
# because Tauri uses platform-native webviews and a host-installed Node.js
# toolchain.
#
# The Dockerfile below is a *reference* recipe that demonstrates the same
# build in an image — useful for reproducible Linux builds on CI runners.
# It is NOT referenced from docker-compose.yml; the cluster compose file
# only orchestrates Bee nodes (Dockerfile).
#
# To build locally instead:
#     cd app
#     npm ci
#     npm run tauri build
#     # bundle: app/src-tauri/target/release/bundle/{dmg,deb,appimage}/...
#
# On macOS the Tauri bundler requires Xcode command-line tools; on Linux
# it needs libwebkit2gtk-4.1-dev, libssl-dev, libgtk-3-dev, libayatana-appindicator3-dev,
# librsvg2-dev, and libsoup-3.0-dev.

FROM rust:1.89-bookworm AS builder

WORKDIR /usr/src/bee-client

RUN apt-get update && apt-get install -y --no-install-recommends \
    nodejs \
    npm \
    libwebkit2gtk-4.1-dev \
    libssl-dev \
    libgtk-3-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    libsoup-3.0-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY app ./app

WORKDIR /usr/src/bee-client/app

RUN npm ci
RUN npm run build
RUN cargo tauri build --bundles deb appimage

FROM scratch

COPY --from=builder /usr/src/bee-client/app/src-tauri/target/release/bundle/deb/*.deb /bee-client.deb
COPY --from=builder /usr/src/bee-client/app/src-tauri/target/release/bundle/appimage/*.AppImage /bee-client.AppImage