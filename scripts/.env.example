# scripts/.env.example — copy to scripts/.env and fill in real values; never commit.
#
# scripts/demo-quant-prod.sh sources this file. The script will refuse
# to run if scripts/.env is missing or any required variable is unset.
#
# All values are connection-level Datasource config. Per-call args
# (symbol, interval, query string, collection, measurement) go in the
# SQL at the call site — they do NOT belong here. See ADR-0010.

# --- Binance (S34) ------------------------------------------------------------
# Optional for public market data. Required for private endpoints or
# rate-limit lifting. Leave blank to use the public WS only.
BINANCE_API_KEY=

# --- Google News / NewsAPI (S35) ----------------------------------------------
# Required. Get a free key at https://newsapi.org — the free tier is
# sufficient for the demo (5 req/sec, 100 req/day for dev mode).
NEWSAPI_KEY=

# --- InfluxDB v2 (S36) --------------------------------------------------------
# Connection-level: URL + token + org. The bucket name is per-call
# (it goes in the EMIT INTO clause in the SQL, not here).
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=

# --- MongoDB (S37) ------------------------------------------------------------
# Connection-level: full URI (scheme + host + port + any credentials +
# any TLS / replica-set options). Database name and collection name are
# per-call (in the EMIT INTO clause), NOT here.
MONGODB_URI=mongodb://localhost:27017
