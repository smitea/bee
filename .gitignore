# S45: mdbook build output. The source lives in
# docs/book/src/ + docs/book/book.toml and is tracked.
/docs/book/book/

# Worktree directories (per-feature isolation)
/.worktrees/

# Built plugin binaries inside the docker per-node plugin volumes.
# Each volumes/node_N/plugins/ dir keeps a .gitkeep so the directory
# structure is tracked; the actual .so / .dylib files are deploy output.
/volumes/*/plugins/*.so
/volumes/*/plugins/*.dylib
/volumes/*/plugins/*.dll
