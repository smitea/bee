# Sample Datasource config for the NewsAPI plugin (S35).
# This is a TEMPLATE — copy to a real config file (e.g., google_news.example.json)
# and supply a real API key. The real config file should NOT be checked
# into version control (add to .gitignore).
#
# Usage:
#   cp .env.example google_news.example.json
#   # edit google_news.example.json with a real NewsAPI key (https://newsapi.org)
#   bee datasource create google_news --adapter google_news_search --config @google_news.example.json

{
  "api_key":            "",
  "base_url":           "https://newsapi.org/v2",
  "rate_limit_per_sec": 5,
  "language":           "en",
  "tenant":             0
}
