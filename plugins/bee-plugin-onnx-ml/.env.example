# Plugin-level config for the onnx-ml plugin (S39).
# This is a TEMPLATE — copy to a real config file (e.g., onnx-ml.example.json)
# and supply the actual model file paths. The real config file should NOT
# be checked into version control (add to .gitignore).
#
# Note: this is a PLUGIN-level config (not a Datasource config). It's
# loaded once at plugin init, not per-Datasource.
#
# Usage:
#   cp .env.example onnx-ml.example.json
#   # edit onnx-ml.example.json with real model paths
#   bee plugin load target/release/libbee_plugin_onnx_ml.dylib --config @onnx-ml.example.json

{
  "sentiment_model_path": "./models/finbert-quant.onnx",
  "decision_model_path":  "./models/btc-direction-1h.onnx",
  "max_batch_size":       32,
  "device":               "cpu"
}
